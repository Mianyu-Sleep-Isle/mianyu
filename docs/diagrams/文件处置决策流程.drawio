        <mxCell id="dedupe" value="去重&#xa;不保存第二份&#xa;记录目标路径与相同哈希" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1090" y="70" width="275" height="120" as="geometry"/></mxCell>
