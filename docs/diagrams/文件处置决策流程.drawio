        <mxCell id="q1" value="是否为运行、契约、唯一设计文档所必需？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="370" y="285" width="260" height="180" as="geometry"/></mxCell>
