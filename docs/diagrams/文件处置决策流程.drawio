        <mxCell id="title" value="每个来源文件如何决定保留、改写、归档或排除" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="330" y="25" width="940" height="40" as="geometry"/></mxCell>
