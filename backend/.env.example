# Optional overrides for the unified backend.
PORT=8787
MIANYU_DB_PATH=data/mianyu.sqlite

# 阿里云百炼 DashScope LLM（OpenAI 兼容模式）。
# - 在 https://dashscope.console.aliyun.com/apiKey 获取 API key。
# - 留空或删除这一行 → 后端降级到规则引擎（不会有 500）。
# - 真实的 key 应放在 backend/.env（已被 .gitignore 忽略），不要提交到仓库。
# - 推荐模型：qwen-plus（性价比均衡）；如需更便宜可选 qwen-turbo，如需更强可选 qwen-max。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 单次 LLM 请求超时（毫秒）。超时后降级到规则引擎。
LLM_TIMEOUT_MS=8000