# Optional overrides for the unified backend.
PORT=8787
MIANYU_DB_PATH=data/mianyu.sqlite

# 阿里云百炼 DashScope LLM（OpenAI 兼容模式）。
# - 在 https://dashscope.console.aliyun.com/apiKey 获取 API key。
# - 留空或删除这一行 → 后端降级到规则引擎（不会有 500）。
# - 真实的 key 应放在 backend/.env（已被 .gitignore 忽略），不要提交到仓库。
# - 推荐模型：qwen-plus（性价比均衡）；如需更便宜可选 qwen-turbo，如需更强可选 qwen-max。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 单次 LLM 请求超时（毫秒）。超时后降级到规则引擎。
LLM_TIMEOUT_MS=8000

# 短片模块。fake = 不连模型，用固定产物跑完状态机；real = 连本机模型。
DRAMA_ENABLED=1
DRAMA_PROVIDERS=fake
DRAMA_WORKER=0
DRAMA_DATA_DIR=data/drama-jobs
DRAMA_SHOWCASE_DIR=data/showcase

# 本机 llama.cpp。密钥不要提交。
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=../services/comfyui/workflows/flux_shot_api.json
TTS_BASE_URL=http://127.0.0.1:9880
FFMPEG_PATH=ffmpeg
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SEC=21600

# supervisorctl 的配置文件。本地 fake 模式用不到。
SUPERVISOR_CONFIG=/hy-tmp/mianyu/deploy/supervisord.conf